# =============================================================================
# Переменные окружения Bronfood CRM Landing
# Скопируйте файл в .env и заполните значения.
# =============================================================================

# Адрес приёма заявок (webhook/API). Если пусто — форма откроет почтовый клиент
# с уже заполненной заявкой (временный сценарий без серверной интеграции).
# Примеры: https://formspree.io/f/xxxxxxx, https://api.bronfood.kz/leads
VITE_APPLICATION_ENDPOINT=

# Формат тела запроса при отправке на endpoint: json | form
# json — application/json, form — application/x-www-form-urlencoded
VITE_APPLICATION_FORMAT=json
